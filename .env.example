TELEGRAM_BOT_TOKEN=replace_me
DEEPSEEK_API_KEY=replace_me
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Optional: comma-separated Telegram user IDs. Otherwise first private /start claims the bot.
ALLOWED_USER_IDS=
DATA_DIR=data
OUTPUT_DIR=output
SEMANTIC_SCHOLAR_API_KEY=
MIN_SOURCES=15
MAX_SOURCES=24
MAX_LLM_CALLS=48
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_BACKEND=fastembed
# LibreOffice executable or absolute path, required for strict PDF export
SOFFICE_PATH=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=gost-research-agent

